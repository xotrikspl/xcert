{
  "general": {
    "default_provider": "ovh",
    "logs": 1,
    "output": "logs/xcert_output.log",
    "error": "logs/xcert_error.log",
    "report": "logs/xcert_report.json",
    "certbot_config_dir": "/etc/letsencrypt",
    "certbot_work_dir": "/var/lib/letsencrypt",
    "certbot_logs_dir": "/var/log/letsencrypt",
    "renew_threshold_days": 30,
    "post_renewal_cmd": "systemctl reload nginx",
    "max_retries": 3,
    "base_backoff_seconds": 60,
    "backoff_jitter_seconds": 15,
    "command_timeout_seconds": 900,
    "sleep_between_domains_seconds": 10,
    "dry_run": 0,
    "language": "en"
  },
  "appearance": {
    "theme": "ledger",
    "colors": "auto",
    "background": "dark"
  },
  "providers": {
    "ovh": {
      "cmd_template": "certbot certonly --dns-ovh --dns-ovh-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/ovh.ini"
    },
    "cloudflare": {
      "cmd_template": "certbot certonly --dns-cloudflare --dns-cloudflare-credentials {credentials} --non-interactive --agree-tos",
      "certbot_plugin_name": "dns-cloudflare",
      "credentials_path": "secrets/cloudflare.ini",
      "propagation_seconds": 90
    },
    "digitalocean": {
      "cmd_template": "certbot certonly --dns-digitalocean --dns-digitalocean-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/digitalocean.ini"
    },
    "dnsimple": {
      "cmd_template": "certbot certonly --dns-dnsimple --dns-dnsimple-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/dnsimple.ini"
    },
    "dnsmadeeasy": {
      "cmd_template": "certbot certonly --dns-dnsmadeeasy --dns-dnsmadeeasy-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/dnsmadeeasy.ini"
    },
    "gehirn": {
      "cmd_template": "certbot certonly --dns-gehirn --dns-gehirn-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/gehirn.ini"
    },
    "google": {
      "cmd_template": "certbot certonly --dns-google --dns-google-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/google.json"
    },
    "linode": {
      "cmd_template": "certbot certonly --dns-linode --dns-linode-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/linode.ini"
    },
    "luadns": {
      "cmd_template": "certbot certonly --dns-luadns --dns-luadns-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/luadns.ini"
    },
    "nsone": {
      "cmd_template": "certbot certonly --dns-nsone --dns-nsone-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/nsone.ini"
    },
    "rfc2136": {
      "cmd_template": "certbot certonly --dns-rfc2136 --dns-rfc2136-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/rfc2136.ini"
    },
    "route53": {
      "cmd_template": "certbot certonly --dns-route53 --non-interactive --agree-tos",
      "credentials_path": null
    },
    "sakuracloud": {
      "cmd_template": "certbot certonly --dns-sakuracloud --dns-sakuracloud-credentials {credentials} --non-interactive --agree-tos",
      "credentials_path": "secrets/sakuracloud.ini"
    }
  },
  "domains": [
    {
      "domain": "example.com",
      "email": "admin@example.com",
      "provider": "ovh"
    },
    {
      "domain": "*.example.com",
      "email": "admin@example.com",
      "provider": "cloudflare"
    }
  ]
}
