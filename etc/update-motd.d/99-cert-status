#!/bin/bash

CONFIG_PATH="/root/.xcert/config.json"
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}=== xCert CERTIFICATE MONITORING ===${NC}"

if [ ! -f "$CONFIG_PATH" ]; then
    echo -e "${RED}Error: config.json not found${NC}"
    exit 1
fi

# Check whether any domains are configured
if ! jq -e '.domains | type == "array" and length > 0' "$CONFIG_PATH" >/dev/null 2>&1; then
    echo -e "${YELLOW}No domains configured.${NC}"
    echo -e "${CYAN}============================================${NC}"
    exit 0
fi

# Iterate over domains safely
while IFS= read -r DOMAIN; do
    [ -z "$DOMAIN" ] && continue

    CLEAN_DOMAIN=$(echo "$DOMAIN" | sed 's/^\*\.\(.*\)/\1/')
    CERT_PATH="/etc/letsencrypt/live/$CLEAN_DOMAIN/fullchain.pem"

    if [ -f "$CERT_PATH" ]; then
        # Read expiry date with a timeout to avoid blocking SSH login
        if ! EXP_DATE_STR=$(timeout 5 openssl x509 -enddate -noout -in "$CERT_PATH" 2>/dev/null | cut -d= -f2); then
            echo -e "${RED}  $DOMAIN: ERROR - Cannot read certificate!${NC}"
            echo ""
            continue
        fi

        # Convert date to epoch seconds
        if ! EXP_SECONDS=$(date -d "$EXP_DATE_STR" +%s 2>/dev/null); then
            echo -e "${RED}  $DOMAIN: ERROR - Invalid date: $EXP_DATE_STR${NC}"
            echo ""
            continue
        fi
        NOW_SECONDS=$(date +%s)
        DAYS_LEFT=$(( (EXP_SECONDS - NOW_SECONDS) / 86400 ))
        NEXT_RENEW=$(date -d "$EXP_DATE_STR" +"%Y-%m-%d")

        # Last renewal date (based on file modification time)
        LAST_MOD_SECONDS=$(stat -c %Y "$CERT_PATH")
        DAYS_AGO=$(( (NOW_SECONDS - LAST_MOD_SECONDS) / 86400 ))
        LAST_DATE=$(date -d "@$LAST_MOD_SECONDS" +"%Y-%m-%d")

        # Color-coded status
        if [ $DAYS_LEFT -lt 0 ]; then
            COLOR=$RED
            STATUS_TEXT="$((-DAYS_LEFT)) days OVERDUE!"
        elif [ $DAYS_LEFT -lt 7 ]; then
            COLOR=$RED
            STATUS_TEXT="$DAYS_LEFT days remaining"
        elif [ $DAYS_LEFT -lt 21 ]; then
            COLOR=$YELLOW
            STATUS_TEXT="$DAYS_LEFT days remaining"
        else
            COLOR=$GREEN
            STATUS_TEXT="$DAYS_LEFT days remaining"
        fi

        echo -e "Domain: ${YELLOW}$DOMAIN${NC}"
        echo -e "  └─ Status: ${COLOR}${STATUS_TEXT}${NC} (Expires: $NEXT_RENEW)"
        echo -e "  └─ Last renewed: $LAST_DATE ($DAYS_AGO days ago)"

        # Progress bar (max 90 days)
        PERCENT=$(( 100 - (DAYS_LEFT * 100 / 90) ))
        [ $PERCENT -lt 0 ] && PERCENT=0
        [ $PERCENT -gt 100 ] && PERCENT=100
        BAR_LEN=$((PERCENT / 5))
        BAR=$(printf "%0.s#" $(seq 1 $BAR_LEN))
        SPACES=$(printf "%0.s." $(seq 1 $((20 - BAR_LEN))))
        echo -e "  └─ Usage: [${COLOR}${BAR}${NC}${SPACES}] ${PERCENT}%"
        echo ""
    else
        echo -e "${RED}  $DOMAIN: ERROR - Certificate not found!${NC}"
        echo ""
    fi
done < <(jq -r '.domains[].domain // empty' "$CONFIG_PATH")

# Systemd timer status
echo -e "${CYAN}Automation status (Systemd Timer):${NC}"
if systemctl is-active --quiet xcert.timer; then
    NEXT_RUN=$(systemctl list-timers --no-pager xcert.timer 2>/dev/null | awk 'NR==2 {print $2, $3}')
    if [ -n "$NEXT_RUN" ]; then
        echo -e "  [${GREEN}ACTIVE${NC}] Next run: $NEXT_RUN"
    else
        echo -e "  [${GREEN}ACTIVE${NC}] (schedule unavailable)"
    fi
else
    echo -e "  [${RED}INACTIVE${NC}] Warning: Auto-renewal is not running!"
fi

echo -e "${CYAN}============================================${NC}"
