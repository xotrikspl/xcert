#!/bin/sh
# Certificate status at SSH login, drawn by xCert in the configured look.
# The timeout keeps a slow openssl or systemctl call from blocking the login.

XCERT_ROOT="${XCERT_ROOT:-/root/.xcert}"

echo
timeout 5 python3 "$XCERT_ROOT/main.py" --config "$XCERT_ROOT/config.json" --motd 2>/dev/null \
    || echo "xCert: status unavailable, run: xcert --list"
