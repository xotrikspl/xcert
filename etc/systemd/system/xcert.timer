[Unit]
Description=Uruchamia xCert raz w tygodniu (w poniedziałek o 01:00)

[Timer]
# Uruchamia skrypt w każdy poniedziałek o godzinie 01:00
OnCalendar=Mon *-*-* 01:00:00
# Zapewnia uruchomienie po starcie systemu, jeśli serwer był wyłączony w terminie
Persistent=true

[Install]
WantedBy=timers.target